<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glow -->
    <path
        android:pathData="M 54,26 L 82,54 L 54,82 L 26,54 Z"
        android:strokeWidth="12"
        android:strokeColor="#336366F1"
        android:strokeLineJoin="round" />

    <!-- Main OmniRoute Diamond Routing Node -->
    <path
        android:pathData="M 54,28 L 80,54 L 54,80 L 28,54 Z"
        android:strokeWidth="6"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80">
                <item android:offset="0.0" android:color="#06B6D4" />
                <item android:offset="0.5" android:color="#6366F1" />
                <item android:offset="1.0" android:color="#A855F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cross Interconnect Lines (Gateway Router) -->
    <path
        android:pathData="M 54,20 L 54,88 M 20,54 L 88,54"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Center Pulse Core -->
    <path
        android:pathData="M 54,46 A 8,8 0 1,0 54,62 A 8,8 0 1,0 54,46 Z"
        android:fillColor="#FFFFFF" />

</vector>
